#pragma once

// Copy this file to config.h and fill in your own values. config.h is
// gitignored so your credentials never get committed.

// Known Wi-Fi networks, in cycle order. The top button (BtnC) advances to the
// next entry and reconnects — add more entries here as needed (e.g. a travel
// router, a phone hotspot). Leave password as "" for an open network.
struct KnownNetwork {
  const char* ssid;
  const char* password;
};

static const KnownNetwork KNOWN_NETWORKS[] = {
  { "your-ssid", "your-password" },
  // { "another-ssid", "its-password" },
};
static const int KNOWN_NETWORKS_COUNT = sizeof(KNOWN_NETWORKS) / sizeof(KNOWN_NETWORKS[0]);

// Volumio host on the local network.
#define VOLUMIO_HOST  "volumio.local"
#define VOLUMIO_PORT  3000   // Volumio's default web/API port

// How often to poll Volumio's getState endpoint for changes.
#define POLL_INTERVAL_MS 5000
